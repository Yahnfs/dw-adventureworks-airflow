# Copie para .env e gere valores proprios para as duas chaves abaixo:
#   docker run --rm --entrypoint python apache/airflow:3.3.2 -c \
#     "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   docker run --rm --entrypoint python apache/airflow:3.3.2 -c \
#     "import secrets; print(secrets.token_urlsafe(48))"
AIRFLOW_UID=50000
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW__CORE__DEFAULT_TIMEZONE=America/Sao_Paulo
AIRFLOW__CELERY__WORKER_CONCURRENCY=4

# Credenciais de demonstracao, validas apenas nos conteineres locais.
OLTP_SA_PASSWORD=AdvWorks2022Dw
DW_USER=dw_user
DW_PASSWORD=dw_pass
DW_DATABASE=dw_adventureworks

AIRFLOW_CONN_OLTP_MSSQL=mssql://sa:AdvWorks2022Dw@oltp-mssql:1433/AdventureWorks2022
AIRFLOW_CONN_DW_POSTGRES=postgres://dw_user:dw_pass@dw-postgres:5432/dw_adventureworks
